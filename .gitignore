# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# NOTE: deliberately NOT using the common `Icon?` pattern here. Its `?` matches
# any single character, so it also excludes the `Icons` asset directory and the
# whole icon set silently disappears from the repo.

# Secrets — never commit these
*.p8
*.p12
*.mobileprovision
*.cer
AuthKey_*.p8
Secrets.plist
.env
.env.*
!.env.example
Config.local.xcconfig
GoogleService-Info.plist
*-firebase-adminsdk-*.json

# Local build tooling
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp
*.swo

# Generated during PDF and icon rendering
docs/tmp_*.html
Branding/.tmp/
