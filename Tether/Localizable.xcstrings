        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप परेशान हों, तो क्या मदद करता है — और क्या और बिगाड़ देता है?"
          }
        }
      }
    },
    "When you have both written about the same day, you will be able to read both sides here.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
