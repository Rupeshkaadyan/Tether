            "state": "translated",
            "value": "ज़ूम करने के लिए पिंच करें, हिलाने के लिए खींचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pellizca para ampliar, arrastra para mover."
          }
        }
      }
    },
