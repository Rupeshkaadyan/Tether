{
  "sourceLanguage": "en",
  "strings": {
    "%@ REPLIED": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ REPLIED"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ respondió"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने जवाब दिया"
          }
        }
      }
    },
    "%@ asked for quiet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ asked for quiet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pidió tranquilidad"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने शांत रहने को कहा"
          }
        }
      }
    },
    "%@ had a hard day. One line from you might land.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ had a hard day. One line from you might land."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tuvo un día difícil. Una línea tuya puede ayudar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का दिन कठिन रहा। आपकी एक पंक्ति काम आ सकती है।"
          }
        }
      }
    },
    "%@ sent you something": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ sent you something"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te envió algo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने आपको कुछ भेजा"
          }
        }
      }
    },
    "%@ will see that you asked for quiet — not why you stopped. No reminders for either of you until it ends.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%@ will see that you asked for quiet — not why you stopped. No reminders for either of you until it ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verá que pediste tranquilidad, no por qué paraste. Sin recordatorios para ninguno hasta que termine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ देखेंगे कि आपने शांत रहने को कहा — यह नहीं कि आप क्यों रुके। खत्म होने तक किसी को याद नहीं दिलाया जाएगा।"
          }
        }
      }
    },
