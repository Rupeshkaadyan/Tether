    "A quiet daily ritual you share with one person. You can begin on your own — everything is here waiting when they join." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "एक शांत दैनिक अनुष्ठान जिसे आप एक व्यक्ति के साथ साझा करते हैं। आप अकेले शुरू कर सकते हैं — जब वे जुड़ेंगे, सब कुछ यहीं इंतज़ार कर रहा होगा।" } }
      }
    },
    "A private space for couples to reflect, understand and grow together — in your own way." : {
      "localizations" : {
        "hi" : { "stringUnit" : { "state" : "translated", "value" : "जोड़ों के लिए एक निजी जगह, जहाँ वे सोच सकें, समझ सकें और साथ बढ़ सकें — अपने अपने तरीके से।" } }
      }
    }
