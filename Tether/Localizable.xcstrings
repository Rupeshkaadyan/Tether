    "Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage in your App Store account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del periodo. Gestiona en tu cuenta de App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यताएँ स्वतः नवीनीकृत होती हैं जब तक कि अवधि समाप्त से 24 घंटे पहले रद्द न करें। अपने App Store खाते में प्रबंधित करें।"
          }
        }
      }
    },
