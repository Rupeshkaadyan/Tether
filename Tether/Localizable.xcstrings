        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के किसी एक पल का नाम लें जब आपको ख़ुशी हुई कि साथ में वही हैं।"
          }
        }
      }
    },
    "Name one thing you appreciate about them that you have never actually said out loud.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra algo que valoras de esa persona y que nunca le has dicho en voz alta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उनमें आप जिस एक बात की कद्र करते हैं और कभी ज़बान से कही नहीं — उसका नाम लें।"
          }
        }
      }
    },
