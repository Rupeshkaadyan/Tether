            "value": "Shown to them. Keep it to what you want them to hold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se le mostrará. Escribe solo lo que quieras que sostenga."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्हें दिखाया जाएगा। वही लिखें जो आप चाहते हैं वे सँभालें।"
