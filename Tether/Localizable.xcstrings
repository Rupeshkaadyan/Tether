    "Off by default. When on, only anonymized counts, mood averages and themes are sent for a richer weekly summary — never your actual words.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Al activarlo solo se envían recuentos anónimos, promedios de ánimo y temas, nunca tus palabras reales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट रूप से बंद। चालू करने पर केवल गुमनाम गिनती, मूड औसत और विषय भेजे जाते हैं — आपके वास्तविक शब्द कभी नहीं।"
          }
        }
      }
    },
