        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन दिन हो गए हैं। इंतज़ार ज़रूरी नहीं — जो भी आप लिखेंगे, वे जुड़ते ही मिल जाएगा।"
          }
