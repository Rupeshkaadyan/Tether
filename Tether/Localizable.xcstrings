        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस डिवाइस की हर प्रविष्टि हटा देता है और एन्क्रिप्शन कुंजी नष्ट कर देता है। इसे वापस नहीं किया जा सकता।"
          }
        }
      }
    },
