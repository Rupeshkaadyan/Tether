    "Everything here was written by you, on your device. Nothing was sent anywhere.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto lo escribiste tú, en tu dispositivo. No se envió nada a ningún sitio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सब आपने अपने डिवाइस पर लिखा है। कुछ भी कहीं नहीं भेजा गया।"
          }
        }
      }
