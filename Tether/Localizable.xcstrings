            "value": "कठिन दिन"
          }
        }
      }
    },
    "A coach, not a therapist": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una guía, no un terapeuta"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक मार्गदर्शक, चिकित्सक नहीं"
          }
        }
      }
    },
    "A day at a time. Past entries will appear here as you go.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día a la vez. Las entradas anteriores aparecerán aquí según avances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-एक दिन। पुरानी प्रविष्टियाँ जैसे-जैसे आप लिखेंगे यहाँ दिखेंगी।"
          }
        }
      }
    },
    "A deeper connection.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conexión más profunda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक गहरा जुड़ाव।"
          }
        }
      }
    },
    "A line is enough.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A line is enough."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea basta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पंक्ति काफ़ी है।"
          }
        }
      }
    },
    "A look back": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mirada atrás"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नज़र पीछे"
          }
        }
      }
    },
    "A pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A pause"
          }
        },
        "es": {
          "stringUnit": {
