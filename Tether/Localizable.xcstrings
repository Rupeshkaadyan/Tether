    "Numbers only. Not one word either of you wrote is on this card — that is the point.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Numbers only. Not one word either of you wrote is on this card — that is the point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo números. Ni una palabra de lo que escribisteis está aquí — de eso se trata."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आँकड़े। आप दोनों का लिखा एक शब्द भी इस कार्ड पर नहीं है — यही बात है।"
          }
