        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह केवल आपका शुरुआती रंग चुनता है। कभी भी बदलें।"
          }
        }
      }
    },
    "This removes every entry on this device and destroys the encryption key. It cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todas las entradas del dispositivo y destruye la clave de cifrado. No se puede deshacer."
