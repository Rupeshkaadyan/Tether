            "value": "अभी नहीं"
          }
        }
      }
    },
    "Not set yet — take the quiz to personalise your insights.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no definido: haz el test para personalizar tu información."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तय नहीं — अपनी जानकारी बेहतर बनाने के लिए क्विज़ लें।"
          }
        }
      }
    },
    "Not sure what to say? Send this:": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No sabes qué decir? Envía esto:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या कहना है समझ नहीं आ रहा? यह भेजें:"
          }
        }
      }
    },
    "Nothing either of you wrote is on this card.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nothing either of you wrote is on this card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que escribisteis está en esta tarjeta."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कार्ड पर आप दोनों का लिखा कुछ भी नहीं है।"
          }
        }
      }
    },
    "Nothing here yet.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada aquí."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी यहाँ कुछ नहीं है।"
          }
        }
      }
    },
    "Nothing in the jar yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nothing in the jar yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El frasco aún está vacío"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जार अभी खाली है"
          }
        }
      }
    },
    "Nothing is expected of you until this ends. No reminders, no streaks at risk, nothing to catch up on.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nothing is expected of you until this ends. No reminders, no streaks at risk, nothing to catch up on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se espera nada de ti hasta que termine. Sin recordatorios, sin rachas en riesgo, nada que recuperar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक यह खत्म न हो, आपसे कुछ अपेक्षित नहीं। कोई याद दिलाना नहीं, कोई श्रृंखला जोखिम में नहीं, कुछ भरपाई नहीं।"
          }
        }
      }
    },
    "Nothing logged this week. No guilt — start again today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada registrado esta semana. Sin culpa: empieza de nuevo hoy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सप्ताह कुछ दर्ज नहीं। कोई गिल्ट नहीं — आज से फिर शुरू करें।"
          }
        }
      }
    },
    "Nothing shared yet": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada compartido aún"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ साझा नहीं"
          }
        }
      }
    },
    "Nothing to chart yet. A few days of entries and this fills in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nothing to chart yet. A few days of entries and this fills in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada que mostrar. Con unos días de entradas se llenará."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी दिखाने के लिए कुछ नहीं। कुछ दिनों की प्रविष्टियों के बाद यह भर जाएगा।"
          }
        }
      }
    },
    "Nothing to compare yet": {
