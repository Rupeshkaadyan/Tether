    "Your coach conversations are never shown to your partner, and never sent to analytics. Encryption is on the roadmap and ships before any sync exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your coach conversations are never shown to your partner, and never sent to analytics. Encryption is on the roadmap and ships before any sync exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus conversaciones con el coach nunca se muestran a tu pareja ni se envían a análisis. El cifrado llegará antes que cualquier sincronización."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कोच बातचीत आपके साथी को कभी नहीं दिखाई जाती और कभी विश्लेषण को नहीं भेजी जाती। एन्क्रिप्शन किसी भी सिंक से पहले आएगा।"
          }
